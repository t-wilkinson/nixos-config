{ pkgs, ... }:
let
  # nixpkgs' Hyprland (0.55 on 26.05), the same one greetd starts. The flake's hyprland input
  # was pinned to v0.40 (2024), so this launcher ran a different Hyprland from the session.
  hyprland = pkgs.hyprland;

  # Hyprland plugins, built by nixpkgs against this exact Hyprland, so an upgrade can't leave
  # them behind (hyprpm compiles them at runtime and breaks on every Hyprland version bump).
  # Loaded from ~/.local/share/hypr/plugins.conf, which config/hypr/hyprland.conf sources.
  # Available: pkgs.hyprlandPlugins.{hyprbars,hyprfocus,hy3,hyprspace,borders-plus-plus,...}
  # (hyprexpo isn't packaged for Hyprland 0.55).
  plugins = with pkgs.hyprlandPlugins; [
    # hyprbars # title bars; its settings are in config/hypr/hyprland/colors.conf
  ];

  launcher = pkgs.writeShellScriptBin "hypr" ''
    #!/${pkgs.bash}/bin/bash

    export WLR_NO_HARDWARE_CURSORS=1
    export _JAVA_AWT_WM_NONREPARENTING=1

    exec ${hyprland}/bin/Hyprland
  '';
in
{
  home.file.".local/share/hypr/plugins.conf".text =
    "# Generated by hosts/nixos/home-manager/hyprland.nix\n"
    + pkgs.lib.concatMapStrings (p: "plugin = ${p}/lib/lib${p.pname}.so\n") plugins;

  home.packages = with pkgs; [
    launcher
    # adoptopenjdk-jre-bin
    temurin-jre-bin
  ];

  xdg.desktopEntries."org.gnome.Settings" = {
    name = "Settings";
    comment = "Gnome Control Center";
    icon = "org.gnome.Settings";
    exec = "env XDG_CURRENT_DESKTOP=gnome ${pkgs.gnome-control-center}/bin/gnome-control-center";
    categories = [ "X-Preferences" ];
    terminal = false;
  };

  programs = {
    swaylock = {
      enable = true;
      package = pkgs.swaylock-effects;
    };
  };
}
