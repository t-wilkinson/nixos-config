#!/bin/sh -e

SCRIPT_DIR=$(git rev-parse --show-toplevel)
SYSTEM_TYPE="aarch64-darwin-wgu"
FLAKE_SYSTEM="darwinConfigurations.${SYSTEM_TYPE}.system"

export NIXPKGS_ALLOW_UNFREE=1

# Build and Switch
nix --extra-experimental-features 'nix-command flakes' build .#$FLAKE_SYSTEM --show-trace
sudo --preserve-env=NIXPKGS_ALLOW_UNFREE ./result/sw/bin/darwin-rebuild switch --flake .#${SYSTEM_TYPE}
unlink ./result

# Clear the environment for wgu
"$SCRIPT_DIR/apps/wgu-env" clear
